# Copia este archivo a .env en la raiz del proyecto y ajusta los valores reales.
# No versionar secretos reales ni credenciales de producción.

# JWT / seguridad
SECRET_KEY=dev-secret-key-change-me
JWT_SECRET=dev-jwt-secret-change-me

# URLs publicas
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:3000
API_GATEWAY_PORT=8000

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# PocketBase
POCKETBASE_URL=
POCKETBASE_AUTH_IDENTITY=
POCKETBASE_AUTH_PASSWORD=
POCKETBASE_TIMEOUT_SECONDS=30
POCKETBASE_RETRY_SECONDS=60
POCKETBASE_USERS_COLLECTION=users
POCKETBASE_SUPPLY_DEMAND_VIEW=vista_supply_demand_60d

# SMTP / email (Mailpit en local)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=labconnect@ucb.edu.bo
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# ML service
ML_CACHE_COLLECTION=prediction_cache
ML_REFRESH_HOUR=3
ML_REFRESH_MINUTE=0
ML_REFRESH_TZ_OFFSET_HOURS=-4
ML_PRECOMPUTE_SUPPLIES=false
ML_CACHE_MAX_AGE_SECONDS=90000

# Reservas
RESERVATION_REMINDER_CHECK_INTERVAL_SECONDS=60

# Extra
AUTH_SERVICE_URL=http://auth-service:8001
INVENTORY_SERVICE_URL=http://inventory-service:8003
ROLE_SERVICE_URL=http://role-service:8004
RESERVATIONS_SERVICE_URL=http://reservation-service:8005
SUPPLY_RESERVATION_SERVICE_URL=http://supply-reservation-service:8006
ML_SERVICE_URL=http://ml-service:8007
